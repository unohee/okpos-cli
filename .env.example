# OKPOS 영업정보시스템 credentials
OKPOS_ID=your_id
OKPOS_PW=your_password
OKPOS_URL=https://okasp.okpos.co.kr/login/login_form.jsp

# Postgres (optional; required for `okpos scrape --to-db` and `okpos export`)
OKPOS_PG_DSN=postgresql://okpos:okpos@localhost:5432/okpos

# Throttle tuning (optional)
OKPOS_MAX_RPS=15
